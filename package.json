    "@neondatabase/serverless": "^1.2.0",
    "@trigger.dev/sdk": "4.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.33.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
