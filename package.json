    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "neon": "^8.3.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
